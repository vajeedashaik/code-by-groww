# ---- Clerk ----
# Dashboard: https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users to sign in / up, and where to go afterwards
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- Supabase ----
# Dashboard: https://supabase.com/dashboard -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon" / "publishable" key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "service_role" / "secret" key (server only, bypasses RLS -- never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
