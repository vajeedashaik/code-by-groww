# ---- Clerk ----
# Dashboard: https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk sends users to sign in / up, and where to go afterwards
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- Supabase ----
# Dashboard: https://supabase.com/dashboard -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon" / "publishable" key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "service_role" / "secret" key (server only, bypasses RLS -- never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Finnhub (Phase 2 — stock search) ----
# Free API key: https://finnhub.io -> Dashboard. Server-only, never exposed to
# the browser. Search still works on the static NSE list if this is missing.
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Market data (Phase 3) ----
# Primary source is `yahoo-finance2` — an npm package, no API key, no signup.
# Finnhub (FINNHUB_API_KEY above) is reused as a secondary source for US symbols.

# ---- Inngest (Phase 3 — scheduled jobs) ----
# Local dev needs NO keys: run `npm run inngest` (inngest-cli dev) next to
# `npm run dev`. The vars below are only for an Inngest Cloud deploy.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---- AI thesis relevance (Phase 7) ----
# The ONE place this product calls an LLM: judges whether recent news
# supports/contradicts a user's stated thesis for a flagged stock. Get a key
# at https://aistudio.google.com/apikey. Server-only — used inside an
# Inngest function via step.ai.infer, never exposed to the browser.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
